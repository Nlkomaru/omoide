# ==============================================================================
# Omoide Environment & Secrets Configuration
# Copy this file to `.env`, fill in the values, and run:
#   pnpm secrets:push   (runs `gh secret set -f .env`)
#   pnpm env:sync       (writes `apps/web/.dev.vars` for local Cloudflare dev)
# ==============================================================================

# Cloudflare Account & API Token (used by Wrangler / Drizzle D1 HTTP / CI deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DATABASE_ID=

# Cloudflare R2 S3-Compatible API (used for presigned PUT URLs for large RAW .ARW files)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=omoide-photos
R2_S3_ENDPOINT=

# Better Auth & OAuth (used by @omoide/web for sessions and `omod_` API keys)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_USERS=Nlkomaru
